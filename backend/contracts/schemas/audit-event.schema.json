{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moderator.local/contracts/v1/audit-event.schema.json",
  "title": "audit-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "actor_id",
    "submission_id",
    "revision_id",
    "knowledge_version_id",
    "metadata"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "content.created",
        "content.submitted",
        "content.revised",
        "content.analysis_completed",
        "content.analysis_failed",
        "content.analysis_retried",
        "finding.acknowledge",
        "finding.accept_suggestion",
        "finding.dismiss",
        "review.approved",
        "review.rejected",
        "review.changes_requested",
        "review.override_approved"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "revision_id": {
      "type": "string"
    },
    "knowledge_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}