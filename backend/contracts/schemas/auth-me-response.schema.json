{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moderator.local/contracts/v1/auth-me-response.schema.json",
  "title": "auth-me-response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "email",
    "role"
  ],
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "creator",
        "reviewer",
        "admin"
      ]
    }
  }
}
