{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moderator.local/contracts/v1/auth-me-response.schema.json",
  "title": "auth-me-response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "email",
    "role",
    "is_active",
    "permissions"
  ],
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "creator",
        "reviewer",
        "admin"
      ]
    },
    "is_active": {
      "type": "boolean"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_create",
        "can_review",
        "can_approve",
        "can_manage_knowledge",
        "can_manage_users"
      ],
      "properties": {
        "can_create": {
          "type": "boolean"
        },
        "can_review": {
          "type": "boolean"
        },
        "can_approve": {
          "type": "boolean"
        },
        "can_manage_knowledge": {
          "type": "boolean"
        },
        "can_manage_users": {
          "type": "boolean"
        }
      }
    }
  }
}